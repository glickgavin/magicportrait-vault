# Copy to .env.local for local dev. In Vercel, set these for Production and Preview.
# Never commit real values.

# App
APP_URL=https://my.magicportraits.ai
GIFT_LINK_SECRET=            # 32+ random bytes, base64; signs /g/[token] links
CRON_SECRET=                 # Vercel Cron sends this as a Bearer token
DATA_SOURCE=live             # live | fixtures (tests and local dev use fixtures)

# Our Supabase project ("magic-vault")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only

# Imagen (imagegen-prod), read-only role vault_reader, pooler transaction mode
IMAGEGEN_DATABASE_URL=
# Events mirror + mug print status (shopify-dailyreport), read-only role vault_reader
MIRROR_DATABASE_URL=

# Shopify, r_orders custom app (server only)
SHOPIFY_STORE_DOMAIN=        # the .myshopify.com domain
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=         # see docs/data.md
SHOPIFY_WEBHOOK_SECRET=      # the app's API secret key

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# PostHog (project 540098, same as magicportraits.ai)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=    # optional: Settings > Tracking counts and scripts/posthog-setup.ts

# Smoke tests during the build (optional)
SMOKE_TEST_EMAIL=            # a staff address with real portraits and orders; the only address the build may email
SMOKE_TEST_ORDER=            # a test order name the build may write the mug choice to
