# The app's variables, set in Vercel for Production and Preview (APP_URL: Production only;
# previews fall back to https://$VERCEL_BRANCH_URL). Tests use the local Supabase stack and fixtures.
# Never commit real values.

# App
APP_URL=https://my.magicportraits.ai
GIFT_LINK_SECRET=            # 32+ random bytes, base64; key for hashing /g/[token] sign-in tokens before storage
CRON_SECRET=                 # Vercel Cron sends this as a Bearer token
DATA_SOURCE=live             # live | fixtures (tests and local dev use fixtures)

# Our Supabase project ("magic-vault")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # the publishable key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=   # the secret key (sb_secret_...); server only

# Imagen (imagegen-prod), read-only role vault_reader, pooler transaction mode
IMAGEGEN_DATABASE_URL=
# Events mirror + mug print status (shopify-dailyreport), read-only role vault_reader
MIRROR_DATABASE_URL=

# Shopify, r_orders custom app (server only)
# r_orders is a Dev Dashboard app: client id + secret, no permanent token. The app gets an Admin API
# token with the client credentials grant (cached ~24 h, refreshed 5 min early and on a 401).
SHOPIFY_STORE_DOMAIN=        # storyboards.myshopify.com (the .myshopify.com domain, not store.magicportraits.ai)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=       # also verifies webhooks (HMAC) and checkout-extension session tokens
# Optional fallback, used only when SHOPIFY_CLIENT_ID/SECRET aren't set: a permanent shpat_ token.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Deprecated: older name for the client secret; read only when SHOPIFY_CLIENT_SECRET isn't set.
# SHOPIFY_WEBHOOK_SECRET=

# Email (AgentMail; inbox cards@magicportraitspartners.com)
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=     # the webhook's Svix signing secret (whsec_...)

# PostHog (project 540098, same as magicportraits.ai)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=    # optional: Settings > Tracking counts and scripts/posthog-setup.ts

# Klaviyo (server only): a private key just for this app; scopes in BUILD.md step 9
KLAVIYO_PRIVATE_KEY=

# Intercom ("Chat With Us", same app as the main site)
NEXT_PUBLIC_INTERCOM_APP_ID=

# --- Not in Vercel: the Claude Code cloud environment (BUILD.md, step 9) ---
# Environment variables there (no secrets; anyone using the environment can read them):
#   SUPABASE_PROJECT_REF=koudexolfdvzmrglzhaz
#   DATA_SOURCE=fixtures
# Network secret there (never an env var): the Supabase access token, host api.supabase.com.
