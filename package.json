{
  "name": "magicportrait-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-events.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:apply-remote": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types --no-warnings scripts/db-apply-remote.ts",
    "auth:configure": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types --no-warnings scripts/configure-auth.ts",
    "db:seed:gen": "node --experimental-strip-types --no-warnings scripts/gen-seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "agentmail": "^0.5.50",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "postgres": "^4.0.0",
    "posthog-js": "^1.445.0",
    "posthog-node": "^5.61.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "svix": "^2.9.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
